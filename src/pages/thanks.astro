---
import Base from '../layouts/Base.astro';
---
<Base title="Postcard received" noindex>
  <main id="main" class="lost wrap">
    <p class="mono" style="margin:0;color:var(--steel)">Postcard received</p>
    <h1>Posted.</h1>
    <p>Thanks for writing. I'll reply within a day, from Delhi.</p>
    <a class="btn" href="/">Back to the field report</a>
  </main>
  <script>import { initCommon } from '../scripts/common.ts'; initCommon();</script>
</Base>
