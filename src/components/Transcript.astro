---
import { transcript, person } from '../data/profile';
---
<section class="block wrap" id="about" data-section="Transcript" aria-labelledby="t-h">
  <div class="kicker mono"><h2 id="t-h">Transcript</h2><span>Six turns · about 50 seconds</span></div>
  <ol class="turns">
    {transcript.map((turn) => (
      <li class={`turn ${turn.who}`}>
        <span class="who mono">
          {turn.who === 'me' && <img class="avatar" src={person.avatar} width="34" height="34" alt="" loading="lazy" decoding="async" />}
          {turn.who === 'me' ? person.first : 'You'} <time>{turn.t}</time>
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        </span>
        <p class="say">{turn.say}</p>
      </li>
    ))}
  </ol>
</section>
